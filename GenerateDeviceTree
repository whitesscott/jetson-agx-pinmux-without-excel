' ==============================================================================
Function GetFirstRow() As Long
    GetFirstRow = Range(RANGE_CONFIG_FIRST).Row
End Function

Function GetLastRow() As Long
    GetLastRow = Range(RANGE_CONFIG_LAST).Row
End Function

Function GetUsage(ByRef RowNumber As Long) As String
    Dim v
    v = Worksheets(ActiveSheet.Name).Cells(RowNumber, Range(RANGE_CONFIG_FIRST).Column).Value
    If IsError(v) Then GetUsage = "" Else GetUsage = CStr(v)
End Function

Function GetDocumentDirectory() As String
    Dim docURL As String
    Dim dirURL As String
    Dim p As Long
    On Error GoTo Fallback
    docURL = ThisComponent.URL
    If docURL = "" Then
        GetDocumentDirectory = CurDir
        Exit Function
    End If
    p = InStrRev(docURL, "/")
    If p > 0 Then
        dirURL = Left(docURL, p - 1)
    Else
        GetDocumentDirectory = CurDir
        Exit Function
    End If
    GetDocumentDirectory = ConvertFromURL(dirURL)
    Exit Function
Fallback:
    GetDocumentDirectory = CurDir
End Function

' ==============================================================================
'  TOP-LEVEL MACRO
' ==============================================================================
Sub Generate_Device_Tree()
    Call InitGlobals()

    Dim RetVal As Integer

    RetVal = MsgBox("Would you like to generate device tree file for pinmux table?", _
                    vbQuestion + vbYesNo)
    If RetVal = vbNo Then Exit Sub

    RetVal = SanityCheck()
    If RetVal <> SUCCESS Then
        MsgBox "Error checking configuration (SanityCheck)." & vbCrLf & _
               "Error code: " & CStr(RetVal), vbExclamation
        Exit Sub
    End If

    RetVal = GenerateFile()
    
    If RetVal <> SUCCESS Then
        If RetVal = ERR_SANITY Then
             MsgBox "Configuration invalid (ERR_SANITY).", vbExclamation
        End If
    End If
End Sub

' ==============================================================================
'  MAIN FILE GENERATOR
' ==============================================================================
Function GenerateFile() As Integer
    InitGlobals

    Dim Boardname          As String
    Dim PinmuxFilename     As String
    Dim GPIOFilename       As String
    Dim PadVoltageFilename As String

    Dim basePath           As String
    Dim PinmuxFilePath     As String
    Dim GPIOFilePath       As String
    Dim PadVoltageFilePath As String

    Dim PinmuxFileNum      As Integer
    Dim GPIOFileNum        As Integer

    Dim MPIOIndex()        As Integer
    Dim MPIOName()         As String
    Dim SFIOName()         As String
    Dim GPIOName()         As String
    Dim GPIOInitValue()    As Integer
    Dim MPIOConfigValue()  As Integer

    Dim NumberOfMPIO       As Integer
    Dim NumberOfSFIO       As Integer
    Dim NumberOfGPIO       As Integer
    Dim NumberOfUnused     As Integer

    Dim RetVal             As Integer
    Dim Ver                As String
    Dim sep                As String

    RetVal = SUCCESS
    GenerateFile = SUCCESS

    On Error GoTo General_Error

    Boardname = InputBox("Type the board name.", "Board Name", _
                         LCase(Replace(ActiveSheet.Name, " Configuration", "")))
    If Boardname = "" Then
        MsgBox "BoardName cannot be empty."
        RetVal = ERR_EMPTY_NAME
        GoTo GenerateFile_End
    End If
    Boardname = LCase(Boardname)

    PinmuxFilename     = "Thor-" & Boardname & "-pinmux.dtsi"
    GPIOFilename       = "Thor-" & Boardname & "-gpio-default.dtsi"
    PadVoltageFilename = "Thor-" & Boardname & "-padvoltage-default.dtsi"

    basePath = GetDocumentDirectory()
    sep = GetPathSeparator()

    PinmuxFilePath     = basePath & sep & PinmuxFilename
    GPIOFilePath       = basePath & sep & GPIOFilename
    PadVoltageFilePath = basePath & sep & PadVoltageFilename

    MsgBox "Writing files to:" & Chr(10) & basePath, vbInformation, "Output Path"

    ' --- OPEN FILES ---
    PinmuxFileNum = FreeFile()
    Open PinmuxFilePath For Output As #PinmuxFileNum

    GPIOFileNum = FreeFile()
    Open GPIOFilePath For Output As #GPIOFileNum

    ' --- READ DATA ---
    RetVal = CountMPIO(NumberOfMPIO, NumberOfSFIO, NumberOfGPIO, NumberOfUnused)
    If RetVal < 0 Then GoTo GenerateFile_End

    RetVal = GroupPins(MPIOIndex, MPIOName, SFIOName, GPIOName, _
                       GPIOInitValue, MPIOConfigValue, _
                       NumberOfSFIO, NumberOfGPIO, NumberOfUnused)
    If RetVal < 0 Then GoTo GenerateFile_End

    Ver = Range("D4").Value

    ' --- WRITE PINMUX ---
    Print #PinmuxFileNum, "/*This dtsi file was generated by " & _
                          Boardname & ".xlsm" & " Revision: " & Ver & " */"
    Print #PinmuxFileNum, CopyRightMessage1
    Print #PinmuxFileNum, CopyRightMessage2 & vbNewLine
    Print #PinmuxFileNum, ""
    Print #PinmuxFileNum, PinmuxIncludeMessage & vbNewLine
    Print #PinmuxFileNum, PadVoltageIncludeMessage & GPIOFilename & Chr(34)
    Print #PinmuxFileNum, ""
    Print #PinmuxFileNum, "pinmux@ac281000 {"

    RetVal = PrintPinmuxDT(PinmuxFileNum, MPIOName, SFIOName, MPIOConfigValue, _
                           NumberOfSFIO, NumberOfGPIO, NumberOfUnused)
    If RetVal < 0 Then GoTo GenerateFile_End
    
    Print #PinmuxFileNum, "};" & vbNewLine & ""

    ' --- WRITE GPIO ---
    Print #GPIOFileNum, "/*This dtsi file was generated by " & _
                        Boardname & ".xlsm" & " Revision: " & Ver & " */"
    Print #GPIOFileNum, CopyRightMessage1
    Print #GPIOFileNum, CopyRightMessage2 & vbNewLine
    Print #GPIOFileNum, GPIOIncludeMessage & vbNewLine
    
    RetVal = PrintGPIODT(GPIOFileNum, "MAIN", GPIOName, GPIOInitValue, _
                         MPIOConfigValue, NumberOfSFIO, NumberOfGPIO, NumberOfUnused)
    RetVal = PrintGPIODT(GPIOFileNum, "UPHY", GPIOName, GPIOInitValue, _
                         MPIOConfigValue, NumberOfSFIO, NumberOfGPIO, NumberOfUnused)
    RetVal = PrintGPIODT(GPIOFileNum, "AON", GPIOName, GPIOInitValue, _
                         MPIOConfigValue, NumberOfSFIO, NumberOfGPIO, NumberOfUnused)
    RetVal = PrintGPIODT(GPIOFileNum, "FSI", GPIOName, GPIOInitValue, _
                         MPIOConfigValue, NumberOfSFIO, NumberOfGPIO, NumberOfUnused)

    ' --- WRITE PAD VOLTAGE ---
    RetVal = PrintPadVoltageFile(PadVoltageFilePath, Boardname, Ver)
    If RetVal < 0 Then GoTo GenerateFile_End

    MsgBox "Successfully wrote:" & vbCrLf & _
           PinmuxFilename & vbCrLf & _
           GPIOFilename & vbCrLf & _
           PadVoltageFilename, vbInformation

GenerateFile_End:
    On Error Resume Next
    If Not (MPIOIndex Is Nothing) Then Erase MPIOIndex
    If Not (MPIOName Is Nothing) Then Erase MPIOName
    If Not (MPIOConfigValue Is Nothing) Then Erase MPIOConfigValue
    If PinmuxFileNum <> 0 Then Close #PinmuxFileNum
    If GPIOFileNum <> 0 Then Close #GPIOFileNum
    GenerateFile = RetVal
    Exit Function

General_Error:
    MsgBox "CRITICAL ERROR in GenerateFile!" & vbCrLf & _
           "Error: " & Err.Description & vbCrLf & _
           "Line: " & Erl & vbCrLf & _
           "Number: " & Err.Number, vbCritical
    RetVal = ERR_FILEIO
    Resume GenerateFile_End
End Function

' ==============================================================================
'  SANITY CHECK / COUNTS
' ==============================================================================
Function SanityCheck() As Integer
    Dim CurrentRow   As Long
    Dim CurrentColumn As Long
    Dim v

    CurrentRow = GetFirstRow()
    Do While CurrentRow <= GetLastRow()
        CurrentColumn = Range(RANGE_ERROR_CHECK).Column 
        v = Worksheets(ActiveSheet.Name).Cells(CurrentRow, CurrentColumn).Value
        If CStr(v) = INVALID Then
            SanityCheck = ERR_SANITY
            Exit Function
        End If
        CurrentRow = CurrentRow + 1
    Loop
    SanityCheck = SUCCESS
End Function

Function CountMPIO(ByRef MPIOCount As Integer, _
                   ByRef SFIOCount As Integer, _
                   ByRef GPIOCount As Integer, _
                   ByRef UnusedCount As Integer) As Integer

    Dim CurrentRow   As Long
    Dim CurrentVal   As Variant
    Dim CurrentUsage As String

    CurrentRow  = GetFirstRow()
    MPIOCount   = 0
    SFIOCount   = 0
    GPIOCount   = 0
    UnusedCount = 0

    On Error GoTo Count_Err

    Do While CurrentRow <= GetLastRow()
        CurrentVal = Worksheets(ActiveSheet.Name).Cells( _
                        CurrentRow, Range(RANGE_CONFIG_FIRST).Column).Value

        If IsError(CurrentVal) Then CurrentVal = ""
        
        If CStr(CurrentVal) <> "" Then
            MPIOCount = MPIOCount + 1
            Dim uVal
            uVal = Worksheets(ActiveSheet.Name).Cells( _
                               CurrentRow, Range(RANGE_CUSTOMER_USAGE).Column).Value
            If IsError(uVal) Then CurrentUsage = "" Else CurrentUsage = CStr(uVal)

            If InStr(1, CurrentUsage, "unused") Then
                UnusedCount = UnusedCount + 1
            ElseIf InStr(1, CurrentUsage, "GPIO3") Then
                GPIOCount = GPIOCount + 1
            Else
                SFIOCount = SFIOCount + 1
            End If
        End If
        CurrentRow = CurrentRow + 1
    Loop

    CountMPIO = SUCCESS
    Exit Function
Count_Err:
    MsgBox "Error in CountMPIO at row " & CurrentRow & ": " & Err.Description
    CountMPIO = -1
End Function

' ==============================================================================
'  ARRAY FILL / GROUPING
' ==============================================================================
Function FillArrays(ByRef MPIOIndex() As Integer, ByRef MPIOName() As String, _
                    ByRef SFIOName() As String, ByRef GPIOName() As String, _
                    ByRef GPIOInitValue() As Integer, ByRef MPIOConfigValue() As Integer, _
                    ByRef NumberOfSFIO As Integer, ByRef NumberOfGPIO As Integer, _
                    ByRef NumberOfUnused As Integer) As Integer

    Dim CurrentRow         As Long
    Dim CurrentVal         As Variant
    Dim CurrentIndex       As Integer
    Dim CurrentSFIOIndex   As Integer
    Dim CurrentGPIOIndex   As Integer
    Dim CurrentUnusedIndex As Integer
    Dim CurrentUsage       As String
    Dim PortName           As String
    Dim PortType           As String
    Dim RetVal             As Integer
    Dim NumberOfMPIO       As Integer

    Const AonListStr  = "AABBCCDDEE"
    Const FsiListStr  = "ABACADAEAFAGAHAJ"
    Const UphyListStr = "ABCDE"

    NumberOfMPIO = NumberOfSFIO + NumberOfGPIO + NumberOfUnused
    
    If NumberOfMPIO = 0 Then
        FillArrays = SUCCESS
        Exit Function
    End If

    ReDim MPIOIndex(NumberOfMPIO) As Integer
    ReDim MPIOName(NumberOfMPIO) As String
    ReDim SFIOName(NumberOfMPIO) As String
    ReDim GPIOName(NumberOfMPIO) As String
    ReDim GPIOInitValue(NumberOfMPIO) As Integer
    ReDim MPIOConfigValue(NumberOfMPIO) As Integer

    CurrentRow         = GetFirstRow()
    CurrentSFIOIndex   = 1
    CurrentGPIOIndex   = 1 + NumberOfSFIO
    CurrentUnusedIndex = 1 + NumberOfSFIO + NumberOfGPIO

    On Error GoTo FillArrays_Fail

    Do While CurrentRow <= GetLastRow()
        CurrentVal = Worksheets(ActiveSheet.Name).Cells( _
                        CurrentRow, Range(RANGE_CONFIG_FIRST).Column).Value
        
        If IsError(CurrentVal) Then CurrentVal = ""

        If CStr(CurrentVal) <> "" Then
            Dim uVal
            uVal = Worksheets(ActiveSheet.Name).Cells( _
                               CurrentRow, Range(RANGE_CUSTOMER_USAGE).Column).Value
            If IsError(uVal) Then CurrentUsage = "" Else CurrentUsage = CStr(uVal)

            If InStr(1, CurrentUsage, "unused") Then
                CurrentIndex = CurrentUnusedIndex
                CurrentUnusedIndex = CurrentUnusedIndex + 1
            ElseIf InStr(1, CurrentUsage, "GPIO3") Then
                CurrentIndex = CurrentGPIOIndex
                CurrentGPIOIndex = CurrentGPIOIndex + 1
            Else
                CurrentIndex = CurrentSFIOIndex
                CurrentSFIOIndex = CurrentSFIOIndex + 1
            End If

            If CurrentIndex > NumberOfMPIO Then GoTo SkipRow

            MPIOIndex(CurrentIndex) = CurrentRow
            
            Dim nVal
            nVal = Worksheets(ActiveSheet.Name).Cells( _
                                       CurrentRow, Range(RANGE_MPIONAME).Column).Value
            If IsError(nVal) Then MPIOName(CurrentIndex) = "UNKNOWN" Else MPIOName(CurrentIndex) = CStr(nVal)

            Dim pOpt
            pOpt = Worksheets(ActiveSheet.Name).Cells( _
                            CurrentRow, Range(RANGE_FIRST_PINMUXING_OPTION).Column).Value
            If IsError(pOpt) Then pOpt = ""
            CurrentVal = CStr(pOpt)
            
            If CurrentVal <> "" Then
                Dim pLen As Integer
                pLen = Len(CurrentVal) - Len("GPIO3_P") - Len(".00")
                If pLen > 0 Then
                    PortName = UCase(Mid(CurrentVal, Len("GPIO3_P") + 1, pLen))

                    If (InStr(FsiListStr, PortName) <> 0) And (Len(PortName) = 2) Then
                        PortType = "TEGRA264_FSI_GPIO("
                    ElseIf (InStr(AonListStr, PortName) <> 0) And (Len(PortName) = 2) Then
                        PortType = "TEGRA264_AON_GPIO("
                    ElseIf (InStr(UphyListStr, PortName) <> 0) And (Len(PortName) = 1) Then
                        PortType = "TEGRA264_UPHY_GPIO("
                    Else
                        PortType = "TEGRA264_MAIN_GPIO("
                    End If
                    GPIOName(CurrentIndex) = PortType & PortName & ", " & Right(CurrentVal, 1) & ")"
                End If
            End If

            If InStr(1, CurrentUsage, "unused") Or InStr(1, CurrentUsage, "GPIO3") Then
                CurrentVal = Worksheets(ActiveSheet.Name).Cells( _
                                 CurrentRow, Range(RANGE_FUNCTION_SAFE).Column).Value
            Else
                CurrentVal = Worksheets(ActiveSheet.Name).Cells( _
                                 CurrentRow, Range(RANGE_CONFIG_FIRST).Column).Value
            End If
            If IsError(CurrentVal) Then SFIOName(CurrentIndex) = "" Else SFIOName(CurrentIndex) = LCase(CStr(CurrentVal))

            MPIOConfigValue(CurrentIndex) = 0

            CurrentVal = GetSafeStr(CurrentRow, Range(RANGE_PUPD).Column)
            RetVal = SetPull(MPIOConfigValue(CurrentIndex), CStr(CurrentVal))
            MPIOConfigValue(CurrentIndex) = RetVal

            CurrentVal = GetSafeStr(CurrentRow, Range(RANGE_TRISTATE).Column)
            RetVal = SetTristate(MPIOConfigValue(CurrentIndex), CStr(CurrentVal))
            MPIOConfigValue(CurrentIndex) = RetVal

            CurrentVal = GetSafeStr(CurrentRow, Range(RANGE_E_INPUT).Column)
            RetVal = SetEInput(MPIOConfigValue(CurrentIndex), CStr(CurrentVal))
            MPIOConfigValue(CurrentIndex) = RetVal

            CurrentVal = GetSafeStr(CurrentRow, Range(RANGE_GPIO_INIT_VALUE).Column)
            If (CurrentVal = "N/A" Or CurrentVal = "") Then
                GPIOInitValue(CurrentIndex) = -1
            ElseIf (CurrentVal = "1") Then
                GPIOInitValue(CurrentIndex) = 1
            Else
                GPIOInitValue(CurrentIndex) = 0
            End If

            CurrentVal = GetSafeStr(CurrentRow, Range(RANGE_RCV_SEL).Column)
            If (CurrentVal <> "") Then
                MPIOConfigValue(CurrentIndex) = SetDDC(MPIOConfigValue(CurrentIndex))
                RetVal = SetRCVSEL(MPIOConfigValue(CurrentIndex), UCase(CurrentVal))
                MPIOConfigValue(CurrentIndex) = RetVal
            End If

            CurrentVal = GetSafeStr(CurrentRow, Range(RANGE_PIN_DIRECTION).Column)
            If (CurrentVal = "Open-Drain") Then
                RetVal = SetOD(MPIOConfigValue(CurrentIndex), "ENABLE")
                MPIOConfigValue(CurrentIndex) = RetVal
            End If

            CurrentVal = GetSafeStr(CurrentRow, Range(RANGE_LOCK).Column)
            If (CurrentVal <> "") Then
                RetVal = SetLock(MPIOConfigValue(CurrentIndex), CStr(CurrentVal))
                MPIOConfigValue(CurrentIndex) = RetVal
            End If

            CurrentVal = GetSafeStr(CurrentRow, Range(RANGE_LPDR).Column)
            If (CurrentVal <> "") Then
                RetVal = SetLPDR(MPIOConfigValue(CurrentIndex), UCase(CurrentVal))
                MPIOConfigValue(CurrentIndex) = RetVal
            End If

            CurrentVal = GetSafeStr(CurrentRow, Range(RANGE_EQOS).Column)
            If (CurrentVal <> "") Then
                MPIOConfigValue(CurrentIndex) = SetHasEQOS(MPIOConfigValue(CurrentIndex))
                RetVal = SetEQOS(MPIOConfigValue(CurrentIndex), UCase(CurrentVal))
                MPIOConfigValue(CurrentIndex) = RetVal
            End If
        End If
SkipRow:
        CurrentRow = CurrentRow + 1
    Loop

    RetVal = SUCCESS
    FillArrays = SUCCESS
    Exit Function

FillArrays_Fail:
    MsgBox "Error in FillArrays at Row " & CurrentRow & ": " & Err.Description
    FillArrays = -1
End Function

Function GetSafeStr(r As Long, c As Long) As String
    Dim v
    v = Worksheets(ActiveSheet.Name).Cells(r, c).Value
    If IsError(v) Then GetSafeStr = "" Else GetSafeStr = CStr(v)
End Function

Function GroupPins(MPIOIndex() As Integer, ByRef MPIOName() As String, _
                   ByRef SFIOName() As String, ByRef GPIOName() As String, _
                   ByRef GPIOInitValue() As Integer, ByRef MPIOConfigValue() As Integer, _
                   ByRef NumberOfSFIO As Integer, ByRef NumberOfGPIO As Integer, _
                   ByRef NumberOfUnused As Integer) As Integer

    Dim RetVal As Integer
    RetVal = FillArrays(MPIOIndex, MPIOName, SFIOName, GPIOName, GPIOInitValue, _
                        MPIOConfigValue, NumberOfSFIO, NumberOfGPIO, NumberOfUnused)
    GroupPins = RetVal
End Function

' ==============================================================================
'  PRINT PINMUX DT (Refactored to write directly to file)
' ==============================================================================
Function PrintPinmuxDT(ByVal FileNum As Integer, ByRef MPIOName() As String, _
                       ByRef SFIOName() As String, ByRef MPIOConfigValue() As Integer, _
                       ByRef MaxSFIOIndex As Integer, ByRef MaxGPIOIndex As Integer, _
                       ByRef MaxUnusedIndex As Integer) As Integer

    Call InitGlobals()

    Dim CurrentIndex As Integer
    Dim MaxUsedIndex As Integer
    Dim MaxIndex As Integer

    MaxUsedIndex = MaxSFIOIndex + MaxGPIOIndex
    MaxIndex     = MaxUsedIndex + MaxUnusedIndex

    Print #FileNum, DoubleTab & "common {"
    Print #FileNum, TripleTab & "/* SFIO Pin Configuration */"

    CurrentIndex = 1
    Do While CurrentIndex <= MaxUsedIndex
        Print #FileNum, TripleTab & MPIOName(CurrentIndex) & " {"
        Print #FileNum, QuadTab & "nvidia,pins = " & Chr(34) & MPIOName(CurrentIndex) & Chr(34) & ";"
        Print #FileNum, QuadTab & "nvidia,function = " & Chr(34) & SFIOName(CurrentIndex) & Chr(34) & ";"
        Print #FileNum, QuadTab & "nvidia,pull = <" & GetPull(MPIOConfigValue(CurrentIndex)) & ">;"
        Print #FileNum, QuadTab & "nvidia,tristate = <" & GetTristate(MPIOConfigValue(CurrentIndex)) & ">;"
        Print #FileNum, QuadTab & "nvidia,enable-input = <" & GetEInput(MPIOConfigValue(CurrentIndex)) & ">;"
        Print #FileNum, QuadTab & "nvidia,drv-type = <" & GetLPDR(MPIOConfigValue(CurrentIndex)) & ">;"

        If (GetLock(MPIOConfigValue(CurrentIndex)) = "TEGRA_PIN_ENABLE") Then
            Print #FileNum, QuadTab & "nvidia,lock = <" & GetLock(MPIOConfigValue(CurrentIndex)) & ">;"
        End If
        If (GetOD(MPIOConfigValue(CurrentIndex)) = "TEGRA_PIN_ENABLE") Then
            Print #FileNum, QuadTab & "nvidia,open-drain = <" & GetOD(MPIOConfigValue(CurrentIndex)) & ">;"
        End If
        If GetDDC(MPIOConfigValue(CurrentIndex)) <> 0 Then
            Print #FileNum, QuadTab & "nvidia,e-io-od = <" & GetRCVSEL(MPIOConfigValue(CurrentIndex)) & ">;"
        End If
        If GetHasEQOS(MPIOConfigValue(CurrentIndex)) <> 0 Then
            Print #FileNum, QuadTab & "nvidia,e-lpbk = <" & GetEQOS(MPIOConfigValue(CurrentIndex)) & ">;"
        End If

        Print #FileNum, TripleTab & "};"
        
        If CurrentIndex < MaxUsedIndex Then Print #FileNum, "" 
        
        If CurrentIndex = MaxSFIOIndex Then
            Print #FileNum, TripleTab & "/* GPIO Pin Configuration */"
        End If
        CurrentIndex = CurrentIndex + 1
    Loop

    Print #FileNum, DoubleTab & "};" & vbNewLine
    Print #FileNum, vbTab & "pinmux_unused_lowpower: unused_lowpower {"

    Do While CurrentIndex <= MaxIndex
        Print #FileNum, TripleTab & MPIOName(CurrentIndex) & " {"
        Print #FileNum, QuadTab & "nvidia,pins = " & Chr(34) & MPIOName(CurrentIndex) & Chr(34) & ";"
        Print #FileNum, QuadTab & "nvidia,function = " & Chr(34) & SFIOName(CurrentIndex) & Chr(34) & ";"
        Print #FileNum, QuadTab & "nvidia,pull = <" & GetPull(MPIOConfigValue(CurrentIndex)) & ">;"
        Print #FileNum, QuadTab & "nvidia,tristate = <" & GetTristate(MPIOConfigValue(CurrentIndex)) & ">;"
        Print #FileNum, QuadTab & "nvidia,enable-input = <" & GetEInput(MPIOConfigValue(CurrentIndex)) & ">;"
        Print #FileNum, QuadTab & "nvidia,drv-type = <" & GetLPDR(MPIOConfigValue(CurrentIndex)) & ">;"

        If (GetLock(MPIOConfigValue(CurrentIndex)) = "TEGRA_PIN_ENABLE") Then
            Print #FileNum, QuadTab & "nvidia,lock = <" & GetLock(MPIOConfigValue(CurrentIndex)) & ">;"
        End If
        If (GetOD(MPIOConfigValue(CurrentIndex)) = "TEGRA_PIN_ENABLE") Then
            Print #FileNum, QuadTab & "nvidia,open-drain = <" & GetOD(MPIOConfigValue(CurrentIndex)) & ">;"
        End If
        If GetDDC(MPIOConfigValue(CurrentIndex)) <> 0 Then
            Print #FileNum, QuadTab & "nvidia,e-io-od = <" & GetRCVSEL(MPIOConfigValue(CurrentIndex)) & ">;"
        End If
        If GetHasEQOS(MPIOConfigValue(CurrentIndex)) <> 0 Then
            Print #FileNum, QuadTab & "nvidia,e-lpbk = <" & GetEQOS(MPIOConfigValue(CurrentIndex)) & ">;"
        End If

        Print #FileNum, TripleTab & "};"
        CurrentIndex = CurrentIndex + 1
        If CurrentIndex <= MaxIndex Then Print #FileNum, ""
    Loop

    Print #FileNum, DoubleTab & "};" & vbNewLine
    Print #FileNum, DoubleTab & "drive_default: drive {"
    Print #FileNum, DoubleTab & "};"

    PrintPinmuxDT = SUCCESS
End Function

' ==============================================================================
'  PRINT GPIO DT (Refactored to write directly to file)
' ==============================================================================
Function PrintGPIODT(ByVal FileNum As Integer, ByRef GPIOType As String, _
                     ByRef GPIOName() As String, ByRef GPIOInitValue() As Integer, _
                     ByRef MPIOConfigValue() As Integer, _
                     ByRef MaxSFIOIndex As Integer, _
                     ByRef MaxGPIOIndex As Integer, _
                     ByRef MaxUnusedIndex As Integer) As Integer

    Call InitGlobals()

    Dim CurrentIndex   As Integer
    Dim MaxUsedIndex   As Integer
    Dim MaxIndex       As Integer
    
    Dim sIn As String
    Dim sLow As String
    Dim sHigh As String
    
    Dim bInFirst As Boolean, bOutLowFirst As Boolean, bOutHighFirst As Boolean
    Dim RetVal As Integer

    MaxUsedIndex = MaxSFIOIndex + MaxGPIOIndex
    MaxIndex     = MaxUsedIndex + MaxUnusedIndex
    RetVal       = SUCCESS
    
    bInFirst = True
    bOutLowFirst = True
    bOutHighFirst = True

    If GPIOType = "MAIN" Then
        Print #FileNum, "gpio@ac300000 {" & vbNewLine & vbTab & " default {"
    ElseIf GPIOType = "UPHY" Then
        Print #FileNum, "gpio@e8300000 {" & vbNewLine & vbTab & " default {"
    ElseIf GPIOType = "AON" Then
        Print #FileNum, "gpio@8cf00000 {" & vbNewLine & vbTab & " default {"
    Else
        Print #FileNum, "gpio@b0320000 {" & vbNewLine & vbTab & " default {"
    End If

    CurrentIndex = MaxSFIOIndex + 1
    
    ' Build string content for pins
    Do While CurrentIndex <= MaxUsedIndex
        If (InStr(GPIOName(CurrentIndex), GPIOType) > 0) Then
            
            If (GPIOInitValue(CurrentIndex) = 1) Then
                If Not bOutHighFirst Then sHigh = sHigh & vbNewLine & TripleTab
                sHigh = sHigh & GPIOName(CurrentIndex)
                bOutHighFirst = False

            ElseIf (GPIOInitValue(CurrentIndex) = 0) Then
                If Not bOutLowFirst Then sLow = sLow & vbNewLine & TripleTab
                sLow = sLow & GPIOName(CurrentIndex)
                bOutLowFirst = False

            ElseIf GetEInput(MPIOConfigValue(CurrentIndex)) = "TEGRA_PIN_ENABLE" Then
                If Not bInFirst Then sIn = sIn & vbNewLine & TripleTab
                sIn = sIn & GPIOName(CurrentIndex)
                bInFirst = False
            End If
        End If
        CurrentIndex = CurrentIndex + 1
    Loop

    ' Output sections
    Print #FileNum, DoubleTab & "gpio-input = <"
    If Len(sIn) > 0 Then Print #FileNum, TripleTab & sIn
    Print #FileNum, TripleTab & ">;"
    
    Print #FileNum, DoubleTab & "gpio-output-low = <"
    If Len(sLow) > 0 Then Print #FileNum, TripleTab & sLow
    Print #FileNum, TripleTab & ">;"

    Print #FileNum, DoubleTab & "gpio-output-high = <"
    If Len(sHigh) > 0 Then Print #FileNum, TripleTab & sHigh
    Print #FileNum, TripleTab & ">;"

    Print #FileNum, vbTab & "};" & vbNewLine & "};"

    PrintGPIODT = RetVal
End Function

' ==============================================================================
'  PRINT PAD VOLTAGE DT
' ==============================================================================
Function PrintPadVoltageFile(ByVal PadVoltageFilePath As String, _
                             ByVal Boardname As String, _
                             ByVal Ver As String) As Integer

    InitGlobals

    Dim PadVoltageFileNum As Integer
    Dim RetVal           As Integer
    Dim CurrentRow       As Long
    Dim LastRow          As Long
    Dim CurrentVoltage   As String
    Dim CurrentRailName  As String
    Dim v

    RetVal = SUCCESS
    PrintPadVoltageFile = SUCCESS

    On Error GoTo PrintPadVoltageFile_Error

    PadVoltageFileNum = FreeFile()
    Open PadVoltageFilePath For Output As #PadVoltageFileNum

    Print #PadVoltageFileNum, "/*This dtsi file was generated by " & _
                              Boardname & ".xlsm" & " Revision: " & Ver & " */"
    Print #PadVoltageFileNum, CopyRightMessage1
    Print #PadVoltageFileNum, CopyRightMessage2 & vbNewLine
    Print #PadVoltageFileNum, "#define IO_PAD_VOLTAGE_1_2V 1200000"
    Print #PadVoltageFileNum, "#define IO_PAD_VOLTAGE_1_8V 1800000"
    Print #PadVoltageFileNum, "#define IO_PAD_VOLTAGE_3_3V 3300000"
    Print #PadVoltageFileNum, ""
    Print #PadVoltageFileNum, ""
    Print #PadVoltageFileNum, "pmc@8c800000 {"
    Print #PadVoltageFileNum, vbTab & "io-pad-defaults {"

    CurrentRow = Range(RANGE_FIRST_PADVOLTAGECONFIG).Row
    LastRow    = Range(RANGE_LAST_PADVOLTAGECONFIG).Row

    Do While CurrentRow <= LastRow
        v = Worksheets(ActiveSheet.Name).Cells( _
                                 CurrentRow, Range(RANGE_FIRST_PADVOLTAGECONFIG).Column).Value
        If IsError(v) Then CurrentRailName = "" Else CurrentRailName = LCase(CStr(v))
        
        v = Worksheets(ActiveSheet.Name).Cells( _
                                 CurrentRow, Range(RANGE_PADVOLTAGECONFIG).Column).Value
        If IsError(v) Then CurrentVoltage = "" Else CurrentVoltage = CStr(v)

        If CurrentRailName <> "" Then
            Print #PadVoltageFileNum, DoubleTab & CurrentRailName & " {"
            If CurrentVoltage = "1.8V" Then
                Print #PadVoltageFileNum, TripleTab & _
                    "nvidia,io-pad-init-voltage = <IO_PAD_VOLTAGE_1_8V>;"
            ElseIf CurrentVoltage = "1.2V" Then
                Print #PadVoltageFileNum, TripleTab & _
                    "nvidia,io-pad-init-voltage = <IO_PAD_VOLTAGE_1_2V>;"
            ElseIf CurrentVoltage = "1.8V/3.3V_default_1.8V" Then
                Print #PadVoltageFileNum, TripleTab & _
                    "nvidia,io-pad-init-voltage = <IO_PAD_VOLTAGE_1_8V>;"
            Else
                Print #PadVoltageFileNum, TripleTab & _
                    "nvidia,io-pad-init-voltage = <IO_PAD_VOLTAGE_3_3V>;"
            End If
            Print #PadVoltageFileNum, DoubleTab & "};" & vbNewLine
        End If
        CurrentRow = CurrentRow + 1
    Loop

    Print #PadVoltageFileNum, vbTab & "};" & vbNewLine & "};"

    Close #PadVoltageFileNum
    Exit Function

PrintPadVoltageFile_Error:
    MsgBox "Error in PrintPadVoltageFile: " & Err.Description
    RetVal = ERR_FILEIO
    PrintPadVoltageFile = RetVal
    On Error Resume Next
    If PadVoltageFileNum <> 0 Then Close #PadVoltageFileNum
End Function

' ==============================================================================
'  BIT-SETTING HELPERS (Identical to previous, kept for completeness)
' ==============================================================================
Function SetType(ByRef ConfigBits As Integer, ByRef PinType As String) As Integer
    Dim NewConfigBits As Integer
    Dim v As String
    v = UCase(Trim(PinType))
    If v = "REG" Then
        NewConfigBits = ConfigBits And (Not CFG_I2C) And (Not CFG_DDC)
    ElseIf v = "I2C" Then
        NewConfigBits = (ConfigBits Or CFG_I2C) And (Not CFG_DDC)
    ElseIf v = "DDC" Then
        NewConfigBits = (ConfigBits And (Not CFG_I2C)) Or CFG_DDC
    Else
        NewConfigBits = ERR_PINTYPE
    End If
    SetType = NewConfigBits
End Function

Function GetType(ByRef ConfigBits As Integer) As Integer
    Dim CheckerNumber As Integer
    CheckerNumber = ConfigBits And (CFG_I2C Or CFG_DDC)
    CheckerNumber = (CheckerNumber \ CFG_I2C) Mod 4
    If CheckerNumber > 2 Then CheckerNumber = ERR_PINTYPE
    GetType = CheckerNumber
End Function

Function SetPull(ByRef ConfigBits As Integer, ByRef PUPD As String) As Integer
    Dim NewConfigBits As Integer
    Dim v As String
    v = UCase(Trim(PUPD))
    If v = "" Or v = "NORMAL" Or v = "N/A" Then
        NewConfigBits = ConfigBits And (Not CFG_PULL_UP) And (Not CFG_PULL_DOWN)
    ElseIf v = "PULL_DOWN" Or v = "PULL-DOWN" Or v = "PULL DOWN" Then
        NewConfigBits = (ConfigBits And (Not CFG_PULL_UP)) Or CFG_PULL_DOWN
    ElseIf v = "PULL_UP" Or v = "PULL-UP" Or v = "PULL UP" Then
        NewConfigBits = (ConfigBits Or CFG_PULL_UP) And (Not CFG_PULL_DOWN)
    Else
        NewConfigBits = ConfigBits
    End If
    SetPull = NewConfigBits
End Function

Function GetPull(ByRef ConfigBits As Integer) As String
    Dim CheckerNumber As Integer
    CheckerNumber = ConfigBits And (CFG_PULL_UP Or CFG_PULL_DOWN)
    CheckerNumber = (CheckerNumber \ CFG_PULL_DOWN) Mod 4
    If CheckerNumber > 2 Then CheckerNumber = ERR_PULL
    If CheckerNumber = 0 Then
        GetPull = "TEGRA_PIN_PULL_NONE"
    ElseIf CheckerNumber = 1 Then
        GetPull = "TEGRA_PIN_PULL_DOWN"
    ElseIf CheckerNumber = 2 Then
        GetPull = "TEGRA_PIN_PULL_UP"
    Else
        GetPull = CStr(CheckerNumber)
    End If
End Function

