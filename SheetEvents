' ==============================================================================
'  EVENT HANDLER
' ==============================================================================
Sub OnContentChanged(oEvent As Object)
    On Error GoTo ErrorHandler
    
    Dim CurrentRow As Long
    Dim CurrentCol As Long
    Dim FirstMpioRow As Long
    Dim LastMpioRow As Long
    Dim Result As Boolean
    
    ' Basic check to ensure a single cell was edited
    If Not oEvent.SupportsService("com.sun.star.sheet.SheetCell") Then Exit Sub

    ' LibreOffice uses 0-based indexing; convert to 1-based for logic
    CurrentRow = oEvent.CellAddress.Row + 1
    CurrentCol = oEvent.CellAddress.Column + 1
    
    ' Use renamed math function to safely find bounds
    FirstMpioRow = ComputeRowIndex(RANGE_FIRST_MPIO)
    LastMpioRow = ComputeRowIndex(RANGE_LAST_MPIO) - 1
    
    If FirstMpioRow < 1 Then FirstMpioRow = 9
    If LastMpioRow < 1 Then LastMpioRow = 5000
    
    ' Check if we are inside the data table rows
    If CurrentRow < FirstMpioRow Or CurrentRow > LastMpioRow Then Exit Sub

    ' --- Logic: Check which column was changed ---
    
    ' 1. Customer Usage Changed
    If CurrentCol = ComputeColIndex(RANGE_CUSTOMER_USAGE) Then
        Result = IsCustomerUsageNotBlank(CurrentRow)
        SetCellValue RANGE_CUSTOMER_USAGE_CHECKER, CurrentRow, Result
        
        If Result Then
            SetCellValue RANGE_PIN_DIRECTION_CHECKER, CurrentRow, IsPinDirectionValid(CurrentRow)
            SetCellValue RANGE_RCV_SEL_CHECKER, CurrentRow, IsRCVSELValid(CurrentRow)
            SetCellValue RANGE_WAKE_CHECKER, CurrentRow, IsWakeValid(CurrentRow)
            
            Dim cVal As String
            cVal = oEvent.String
            If Right(cVal, 1) = "*" Then
                MsgBox "Warning: Please check with Nvidia AEs before using this function."
            End If
        End If
    End If
    
    ' 2. Pin Direction Changed
    If CurrentCol = ComputeColIndex(RANGE_PIN_DIRECTION) Then
        SetCellValue RANGE_PIN_DIRECTION_CHECKER, CurrentRow, IsPinDirectionValid(CurrentRow)
        SetCellValue RANGE_WAKE_CHECKER, CurrentRow, IsWakeValid(CurrentRow)
    End If
    
    ' 3. Initial State Changed
    If CurrentCol = ComputeColIndex(RANGE_INITIAL_STATE) Then
        SetCellValue RANGE_INITIAL_STATE_CHECKER, CurrentRow, IsInitialStateValid(CurrentRow)
        SetCellValue RANGE_RESISTOR_CHECKER, CurrentRow, IsResistorConfigurationGood(CurrentRow)
    End If
    
    ' 4. Wake Pin Changed
    If CurrentCol = ComputeColIndex(RANGE_WAKE_PIN) Then
        SetCellValue RANGE_WAKE_CHECKER, CurrentRow, IsWakeValid(CurrentRow)
    End If
    
    ' 5. Ext Pull Up Changed
    If CurrentCol = ComputeColIndex(RANGE_EXT_PU) Then
        SetCellValue RANGE_RESISTOR_CHECKER, CurrentRow, IsResistorConfigurationGood(CurrentRow)
    End If
    
    ' 6. Ext Pull Down Changed
    If CurrentCol = ComputeColIndex(RANGE_EXT_PD) Then
        SetCellValue RANGE_RESISTOR_CHECKER, CurrentRow, IsResistorConfigurationGood(CurrentRow)
    End If
    
    ' 7. RCV_SEL Changed (3.3V Tolerance)
    If CurrentCol = ComputeColIndex(RANGE_RCV_SEL) Then
        SetCellValue RANGE_RCV_SEL_CHECKER, CurrentRow, IsRCVSELValid(CurrentRow)
    End If

    Exit Sub

ErrorHandler:
    MsgBox "Error in OnContentChanged: " & Err & " - " & Error$
End Sub

' ==============================================================================
'  HELPER FUNCTIONS (Renamed and Simplified to avoid Property Errors)
' ==============================================================================

' Safely calculate Column Index (1-based) from Address String (e.g. "AS7" -> 45)
Function ComputeColIndex(ByVal AddrStr As String) As Long
    Dim i As Long
    Dim colStr As String
    Dim c As String
    Dim colNum As Long
    Dim alpha As String
    Dim idx As Long
    
    ' Define explicit alphabet string to avoid Asc() issues
    alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    colStr = ""
    AddrStr = UCase(AddrStr)
    
    ' Extract letters
    For i = 1 To Len(AddrStr)
        c = Mid(AddrStr, i, 1)
        If InStr(alpha, c) > 0 Then
            colStr = colStr & c
        ElseIf c <> "$" Then
            ' Stop at numbers or other chars
            Exit For
        End If
    Next i
    
    ' Convert Base26 to Integer using InStr lookup
    colNum = 0
    For i = 1 To Len(colStr)
        c = Mid(colStr, i, 1)
        idx = InStr(alpha, c)
        colNum = colNum * 26 + idx
    Next i
    
    ComputeColIndex = colNum
End Function

' Safely calculate Row Index from Address String
Function ComputeRowIndex(ByVal AddrStr As String) As Long
    Dim i As Long
    Dim rowStr As String
    Dim c As String
    
    rowStr = ""
    For i = 1 To Len(AddrStr)
        c = Mid(AddrStr, i, 1)
        If IsNumeric(c) Then
            rowStr = rowStr & c
        End If
    Next i
    
    If rowStr <> "" Then ComputeRowIndex = CLng(rowStr) Else ComputeRowIndex = -1
End Function

' Helper to Write value to cell safely
Sub SetCellValue(AddrStr As String, r As Long, Val As Variant)
    On Error Resume Next
    Dim oSheet As Object
    Dim c As Long
    c = ComputeColIndex(AddrStr)
    
    If c > 0 Then
        oSheet = ThisComponent.CurrentController.ActiveSheet
        ' getCellByPosition uses (Column, Row) and is 0-based
        oSheet.getCellByPosition(c - 1, r - 1).String = CStr(Val)
    End If
End Sub

' Helper to Read value from cell safely
Function ReadCellValue(r As Long, c As Long) As String
    On Error Resume Next
    Dim oSheet As Object
    oSheet = ThisComponent.CurrentController.ActiveSheet
    If c > 0 And r > 0 Then
        ReadCellValue = oSheet.getCellByPosition(c - 1, r - 1).String
    Else
        ReadCellValue = ""
    End If
End Function

' ==============================================================================
'  LOGIC FUNCTIONS
' ==============================================================================

Function IsPinDirectionValid(ByVal CurrentRow As Long) As Boolean
    Dim SelectedCustomerUsage As String
    Dim SelectedPinDirection As String
    Dim AllowedPinDirection As String
    
    SelectedCustomerUsage = ReadCellValue(CurrentRow, ComputeColIndex(RANGE_CUSTOMER_USAGE))
    SelectedPinDirection  = ReadCellValue(CurrentRow, ComputeColIndex(RANGE_PIN_DIRECTION))
    
    If Left(SelectedCustomerUsage, 7) = "unused_" And SelectedPinDirection <> "Not Assigned" And SelectedPinDirection <> "" Then
        IsPinDirectionValid = False
        MsgBox "Error: Cannot assign a pin direction for an unused pin."
        Exit Function
    ElseIf SelectedPinDirection = "Not Assigned" Then
        IsPinDirectionValid = True
        Exit Function
    End If
     
    ' Look up valid usage types from header row 7 based on column position
    If SelectedCustomerUsage = ReadCellValue(CurrentRow, ComputeColIndex(RANGE_PINMUX_GPIO)) Then
        AllowedPinDirection = ReadCellValue(CurrentRow, ComputeColIndex(RANGE_ALLOWED_PIN_DIRECTION_GPIO))
    ElseIf SelectedCustomerUsage = ReadCellValue(CurrentRow, ComputeColIndex(RANGE_PINMUX_SFIO0)) Then
        AllowedPinDirection = ReadCellValue(CurrentRow, ComputeColIndex(RANGE_ALLOWED_PIN_DIRECTION_SFIO0))
    ElseIf SelectedCustomerUsage = ReadCellValue(CurrentRow, ComputeColIndex(RANGE_PINMUX_SFIO1)) Then
        AllowedPinDirection = ReadCellValue(CurrentRow, ComputeColIndex(RANGE_ALLOWED_PIN_DIRECTION_SFIO1))
    ElseIf SelectedCustomerUsage = ReadCellValue(CurrentRow, ComputeColIndex(RANGE_PINMUX_SFIO2)) Then
        AllowedPinDirection = ReadCellValue(CurrentRow, ComputeColIndex(RANGE_ALLOWED_PIN_DIRECTION_SFIO2))
    ElseIf SelectedCustomerUsage = ReadCellValue(CurrentRow, ComputeColIndex(RANGE_PINMUX_SFIO3)) Then
        AllowedPinDirection = ReadCellValue(CurrentRow, ComputeColIndex(RANGE_ALLOWED_PIN_DIRECTION_SFIO3))
    End If
        
    If AllowedPinDirection = "I" And SelectedPinDirection <> "Input" Then
        IsPinDirectionValid = False
        MsgBox ("Error: " & SelectedCustomerUsage & " should not be set as " & SelectedPinDirection & ".")
    ElseIf AllowedPinDirection = "O" And SelectedPinDirection <> "Output" Then
        IsPinDirectionValid = False
        MsgBox ("Error: " & SelectedCustomerUsage & " should not be set as " & SelectedPinDirection & ".")
    Else
        IsPinDirectionValid = True
    End If
End Function

Function IsCustomerUsageNotBlank(ByVal CurrentRow As Long) As Boolean
    Dim val As String
    val = ReadCellValue(CurrentRow, ComputeColIndex(RANGE_CUSTOMER_USAGE))
    If val = "" Then
        MsgBox ("Error: Customer Usage cannot be blank")
        IsCustomerUsageNotBlank = False
    Else
        IsCustomerUsageNotBlank = True
    End If
End Function

Function IsResistorConfigurationGood(ByVal CurrentRow As Long) As Boolean
    Dim SelectedInitialState As String
    Dim SelectedExtPU As String
    Dim SelectedExtPD As String

    SelectedInitialState = ReadCellValue(CurrentRow, ComputeColIndex(RANGE_INITIAL_STATE))
    SelectedExtPU        = ReadCellValue(CurrentRow, ComputeColIndex(RANGE_EXT_PU))
    SelectedExtPD        = ReadCellValue(CurrentRow, ComputeColIndex(RANGE_EXT_PD))
    
    If SelectedInitialState = "Int PU" And SelectedExtPU <> "" Then
        MsgBox ("Error: Internal pull up cannot be enabled if there is an external pull up.")
        IsResistorConfigurationGood = False
    ElseIf SelectedInitialState = "Int PU" And SelectedExtPD <> "" Then
        MsgBox ("Error: Internal pull up cannot be enabled if there is an external pull down.")
        IsResistorConfigurationGood = False
    ElseIf SelectedInitialState = "Int PD" And SelectedExtPU <> "" Then
        MsgBox ("Error: Internal pull down cannot be enabled if there is an external pull up.")
        IsResistorConfigurationGood = False
    ElseIf SelectedInitialState = "Int PD" And SelectedExtPD <> "" Then
        MsgBox ("Error: Internal pull down cannot be enabled if there is an external pull down.")
        IsResistorConfigurationGood = False
    Else
        IsResistorConfigurationGood = True
    End If
End Function

Function IsInitialStateValid(ByVal CurrentRow As Long) As Boolean
    Dim SelectedCustomerUsage As String
    Dim SelectedInitialState As String

    SelectedCustomerUsage = ReadCellValue(CurrentRow, ComputeColIndex(RANGE_CUSTOMER_USAGE))
    SelectedInitialState  = ReadCellValue(CurrentRow, ComputeColIndex(RANGE_INITIAL_STATE))

    If Left(SelectedCustomerUsage, 7) = "unused_" And SelectedInitialState <> "" And SelectedInitialState <> "Z" And SelectedInitialState <> "N/A" Then
        MsgBox "Error: Initial State for an Unused Pin cannot be assigned to " & SelectedInitialState & "."
        IsInitialStateValid = False
    Else
        IsInitialStateValid = True
    End If
End Function

Function IsWakeValid(ByVal CurrentRow As Long) As Boolean
    Dim SelectedWakePin As String
    Dim SelectedPinDirection As String
    Dim SelectedCustomerUsage As String

    IsWakeValid = True
    SelectedWakePin      = ReadCellValue(CurrentRow, ComputeColIndex(RANGE_WAKE_PIN))
    SelectedPinDirection = ReadCellValue(CurrentRow, ComputeColIndex(RANGE_PIN_DIRECTION))
    SelectedCustomerUsage= ReadCellValue(CurrentRow, ComputeColIndex(RANGE_CUSTOMER_USAGE))
    
    If SelectedWakePin = "" Then Exit Function
    
    If SelectedWakePin = "Yes" And Left(SelectedCustomerUsage, 7) = "unused_" Then
        MsgBox ("Error: Wake cannot be enabled on an Unused Pin")
        IsWakeValid = False
    End If
    
    If SelectedWakePin = "Yes" And SelectedPinDirection = "Output" Then
        MsgBox ("Error: Wake cannot be enabled on an Output")
        IsWakeValid = False
    ElseIf SelectedWakePin = "Yes" And SelectedPinDirection = "Not Assigned" Then
        MsgBox ("Error: Wake cannot be enabled on an Unassigned pin")
        IsWakeValid = False
    End If
End Function

Function IsRCVSELValid(ByVal CurrentRow As Long) As Boolean
    Dim SelectedRCVSEL As String
    Dim SelectedCustomerUsage As String

    IsRCVSELValid = True
    SelectedRCVSEL        = ReadCellValue(CurrentRow, ComputeColIndex(RANGE_RCV_SEL))
    SelectedCustomerUsage = ReadCellValue(CurrentRow, ComputeColIndex(RANGE_CUSTOMER_USAGE))
    
    If SelectedRCVSEL = "" Then Exit Function
    
    If SelectedRCVSEL = "Enable" And Left(SelectedCustomerUsage, 7) = "unused_" Then
        MsgBox ("Error: 3.3V Tolerance cannot be enabled on an Unused Pin")
        IsRCVSELValid = False
    End If
End Function
